{
  "name": "eal-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @eal/web dev",
    "build": "pnpm --filter @eal/web build",
    "start": "pnpm --filter @eal/web start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "pnpm --filter @eal/design-tokens test && pnpm --filter @eal/domain test && pnpm --filter @eal/analytics test && pnpm --filter @eal/web test:unit",
    "test:component": "pnpm --filter @eal/web test:component",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:security": "node scripts/check-secrets.mjs",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "check:dependencies": "node scripts/check-workspace-dependencies.mjs",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm test:security && pnpm check:dependencies"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
