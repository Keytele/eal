# Deployment identity. All variables are server-only unless explicitly prefixed NEXT_PUBLIC_.
EAL_DEPLOYMENT_ENV=
EAL_APP_ORIGIN=
EAL_LOG_LEVEL=

# Keep commerce mutations disabled until a reviewed provider adapter is connected.
EAL_COMMERCE_MUTATIONS_ENABLED=
EAL_COMMERCE_PROVIDER_ENDPOINT=
EAL_COMMERCE_PROVIDER_TOKEN=

# CMS access is optional during the scaffold stage and must never be client-exposed.
EAL_CMS_ENDPOINT=
EAL_CMS_TOKEN=

# All launch flags are opt-in and default to false.
EAL_FEATURE_MARKET_AU=
EAL_FEATURE_MARKET_CN=
EAL_FEATURE_FINANCE=
EAL_FEATURE_RESERVATION=
EAL_FEATURE_PROVIDER_INTEGRATIONS=
